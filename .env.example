# ============================================================
# Suburban Integrated Services — root reference env file
# Copy app-specific values into apps/api/.env and apps/web/.env.local
# ============================================================

# ---------- API (apps/api/.env) ----------
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# Key required (header: x-admin-key) to read/manage contact submissions
ADMIN_API_KEY=change-me

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres@localhost:5432/suburban?schema=public

# Outgoing email (contact form notifications). Leave SMTP_HOST empty to
# log emails to the console instead of sending them (useful in dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Suburban Integrated Services <no-reply@suburbanintegratedservices.com>"
# Where contact-form notifications are delivered
MAIL_TO=suburbanintegratedservices@gmail.com

# ---------- WEB (apps/web/.env.local) ----------
# Base URL of the NestJS API (must include the global prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_NAME=Suburban Integrated Services Limited
NEXT_PUBLIC_SITE_URL=https://www.suburbanintegratedservices.com
