NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000


# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres@localhost:5432/suburban?schema=public

# Outgoing email. Leave SMTP_HOST empty to log emails to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Suburban Integrated Services <no-reply@suburbanintegratedservices.com>"
MAIL_TO=suburbanintegratedservices@gmail.com

# Admin auth. Generate each secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# COOKIE_SECURE defaults to true when NODE_ENV=production
COOKIE_SECURE=false
COOKIE_DOMAIN=

# First admin account, created by `npm run seed` if no users exist yet.
SEED_ADMIN_EMAIL=admin@suburbanintegratedservices.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Site Administrator

# Where uploaded media is written (served at /uploads; nginx serves it in production)
UPLOAD_DIR=./uploads

# Public site, pinged to refresh pages after content changes.
# REVALIDATE_SECRET must match apps/web REVALIDATE_SECRET.
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
