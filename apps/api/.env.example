NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Key required (header: x-admin-key) to read/manage contact submissions.
ADMIN_API_KEY=change-me

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres@localhost:5432/suburban?schema=public

# Outgoing email. Leave SMTP_HOST empty to log emails to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Suburban Integrated Services <no-reply@suburbanintegratedservices.com>"
MAIL_TO=suburbanintegratedservices@gmail.com
