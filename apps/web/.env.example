NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_NAME=Suburban Integrated Services Limited
NEXT_PUBLIC_SITE_URL=https://www.suburbanintegratedservices.com

# Server-side API address, e.g. http://127.0.0.1:4000/api in production so
# page rendering does not go out through nginx. Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Shared secret the API uses to refresh pages after content changes.
# Must match REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=change-me
